# dependências (reinstalam com npm install) e segredos
node_modules/
.env
.env.*

# Node.js portátil baixado pelo iniciar-servidor.bat (máquina sem Node instalado)
.node-portatil/

# temporários gerados por testes/ferramentas
*.log
.wolf/designqc-captures/
chrome/
*.ljw.tmp
*.ljw.corrompido-*
/profiles/
# perfis crus do perfilador (podem ter dado de aparelho) — só o resumo agregado
# e anônimo em registros/ é versionado.
/profiles-escola/

# mundos vivos (saves da turma) — ficam locais no host, não versionados.
# Os MODELOS distribuídos ficam em cenarios/ (esses sim versionados).
/mundos/
/world.ljw
# save que o host Node cria quando sobe SEM LJ_SAVE. Já esteve versionado por
# acidente, carregando roster com PIN e código de professor de teste — e o repo
# é público. Nada lê este arquivo; ele só existe como resíduo de smoke.
/server/world.ljw

# OpenWolf runtime (estado local por máquina — não versionar; solta a árvore pro `npm version`)
.wolf/hooks/_session.json
.wolf/token-ledger.json
.wolf/_scan-state.json
# token do dashboard local = SEGREDO, nunca versionar
.wolf/dashboard-token
# backups locais de upgrades/consolidações do OpenWolf
.wolf.bak-*/
.wolf/*.bak
# snapshots por sessão que a rotação do OpenWolf cria (cópia do que já é
# versionado — 3 MB por rodada, cresce sem fim). Local, nunca no repo.
.wolf/backups/

# versao instalada pelo launcher do Windows (o commit baixado do GitHub).
# E estado da maquina da escola, nao do repo.
.lj-versao
